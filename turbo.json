{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": [".env"],
    "tasks": {
        "build": {
            "env": [
                "CACHE_REVALIDATION_TOKEN",
                "CONTENTFUL_SPACE_ID",
                "CONTENTFUL_ACCESS_TOKEN",
                "CONTENTFUL_PREVIEW_ACCESS_TOKEN"
            ],
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**"]
        },
        "format": {
            "dependsOn": ["^fmt"]
        },
        "dev": {
            "persistent": true,
            "cache": false
        }
    }
}
